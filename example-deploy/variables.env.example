# Copy to `variables.env` and fill in actual values. Do NOT commit the filled
# version — it contains live R2 + SMTP credentials.
#
# Three groups:
#   1. Site / web basics       — Overleaf branding + URL
#   2. R2 (filestore + history) — split into reader (filestore) + writer (history-v1)
#   3. CLSI                    — point web at the clsi-proxy that forwards to CF
#   4. SMTP                    — outgoing email
#   5. Misc CE behavior        — feature toggles

# ------- Site / web basics -------
OVERLEAF_SITE_URL=https://overleaf.example.com
OVERLEAF_APP_NAME=Overleaf
OVERLEAF_NAV_TITLE=Overleaf
OVERLEAF_ADMIN_EMAIL=admin@example.com
OVERLEAF_BEHIND_PROXY=true
OVERLEAF_SECURE_COOKIE=true

# ------- R2 / filestore on S3 backend -------
# filestore (web's per-request blob fetches): READER credentials are sufficient.
OVERLEAF_FILESTORE_BACKEND=s3
OVERLEAF_FILESTORE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
OVERLEAF_FILESTORE_S3_REGION=auto
OVERLEAF_FILESTORE_S3_PATH_STYLE=true
OVERLEAF_FILESTORE_S3_ACCESS_KEY_ID=          # R2 reader token id
OVERLEAF_FILESTORE_S3_SECRET_ACCESS_KEY=      # R2 reader token secret
# Templates aren't used by this deploy; point at any existing bucket as a stub.
OVERLEAF_FILESTORE_TEMPLATE_FILES_BUCKET_NAME=overleaf-history-project-blobs

# ------- R2 / history-v1 on S3 backend -------
# history-v1 needs to read AND write blobs/chunks/zips → WRITER credentials.
OVERLEAF_HISTORY_BACKEND=s3
OVERLEAF_HISTORY_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
OVERLEAF_HISTORY_S3_REGION=auto
OVERLEAF_HISTORY_S3_PATH_STYLE=true
OVERLEAF_HISTORY_S3_ACCESS_KEY_ID=            # R2 writer token id
OVERLEAF_HISTORY_S3_SECRET_ACCESS_KEY=        # R2 writer token secret
OVERLEAF_HISTORY_BLOBS_BUCKET=overleaf-history-blobs
OVERLEAF_HISTORY_PROJECT_BLOBS_BUCKET=overleaf-history-project-blobs
OVERLEAF_HISTORY_CHUNKS_BUCKET=overleaf-history-chunks
OVERLEAF_HISTORY_ZIPS_BUCKET=overleaf-history-zips

# ------- CLSI on Cloudflare via the clsi-proxy sidecar -------
# Web in the fork is patched to send all CLSI calls to CLSI_HOST. clsi-proxy
# adds the bearer header and forwards to ${CLSI_CF_HOST}.
CLSI_HOST=clsi-proxy
# The R2 bucket clsi-rs writes outputs to (the fork's R2OutputClient presigns
# from here when minting 302 redirects for the browser).
OVERLEAF_CLSI_OUTPUT_BUCKET=overleaf-clsi-output

# ------- SMTP (outgoing email — password resets, invites) -------
OVERLEAF_EMAIL_FROM_ADDRESS=noreply@example.com
OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
OVERLEAF_EMAIL_SMTP_PORT=587
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_NAME=
OVERLEAF_EMAIL_SMTP_USER=
OVERLEAF_EMAIL_SMTP_PASS=

# ------- Misc CE behavior -------
EMAIL_CONFIRMATION_DISABLED=true
EXTERNAL_AUTH=false
ENABLE_CONVERSIONS=false
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
